upstream socket_backend {
        server unix:/home/ubuntu/code/Proxy_Management/AsyncSocketExchange/backend/run/gunicorn.sock fail_timeout=0; 
}

server {
        if ($host = ${DOMAIN}) {
                return 301 https://$host$request_uri; 
        }

       server_name     ${DOMAIN} www.${DOMAIN};
        listen          80 default_server;

       location /.well-known/acme-challenge/ {
                allow all;
        }

        return 404;
}

map $server_port $x_forwarded_port {
	80      80;
	443     443;
	default $server_port;
}

server {
        server_name         ${DOMAIN} www.${DOMAIN};
        listen              ${SERVER_PORT} ssl;
        ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem; 
        include             /etc/letsencrypt/options-ssl-nginx.conf;   
        ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;         
        server_tokens       off;
        proxy_set_header    Host                $host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $scheme;


	# Conditionally set X-Forwarded-Port
	proxy_set_header    X-Forwarded-Port    $x_forwarded_port;

        # location for https        
        location / {
                proxy_pass              http://socket_backend;
                
                # proxy_cache name located in nginx.conf file
                # proxy_cache             wireguard_cache;
                # proxy_cache_valid       200 302 60m;
                # proxy_cache_valid       404 1m;
        }

        if ($request_method = OPTIONS) {
                        add_header 'Access-Control-Allow-Origin' $http_origin;
                        add_header 'Access-Control-Allow-Credentials' 'true';
                        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
                        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type';
                        add_header 'Content-Type' 'text/plain; charset=utf-8';
                        add_header 'Content-Length' 0;
                        return 204;
                }
                add_header 'Access-Control-Allow-Origin' '*';
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE';
                add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';

        location /static {
                alias /home/ubuntu/code/Proxy_Management/AsyncSocketExchange/backend/static;
        }

        # location for wesockets
        location /ws/ {
                proxy_pass http://socket_backend;
                proxy_http_version              1.1;
                proxy_set_header Upgrade        $http_upgrade;
                proxy_set_header Connection     "upgrade";
        }

        location /conf/ {
                alias /home/ubuntu/code/vars/;
                auth_basic "Configuration";
                auth_basic_user_file /home/ubuntu/.htpasswd;
        }

        location /docs {
                auth_basic "Documentation";
                auth_basic_user_file /home/ubuntu/.htpasswd;

                if ($request_method = OPTIONS) {
                        add_header 'Access-Control-Allow-Origin' $http_origin;
                        add_header 'Access-Control-Allow-Credentials' 'true';
                        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
                        add_header 'Access-Control-Allow-Headers' 'Authorization, Content-Type';
                        add_header 'Content-Type' 'text/plain; charset=utf-8';
                        add_header 'Content-Length' 0;
                        return 204;
                }

                add_header 'Access-Control-Allow-Origin' '*';
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE';
                add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';

                proxy_pass                              http://socket_backend/docs;
                proxy_set_header Host                   $host;
                proxy_set_header X-Real-IP              $remote_addr;
                proxy_set_header X-Forwarded-For        $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto      $scheme;
        }

}