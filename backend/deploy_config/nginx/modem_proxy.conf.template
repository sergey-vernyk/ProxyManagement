upstream socket_backend {
	server backend:8000;
}

server {
	server_name     ${DOMAIN} www.${DOMAIN} stage.${DOMAIN};
	listen          80 default_server;
	
	location /.well-known/acme-challenge/ {
		root 	/var/www/certbot;
		allow 	all;
	}

	location / {
		return 301 https://$host$request_uri;
	} 

	return 404;
}

map $server_port $x_forwarded_port {
	80      80;
	443     443;
	default $server_port;
}

server {
	server_name     	  	${DOMAIN} www.${DOMAIN};
	listen        	  	  	443 ssl;
	ssl_certificate     	/etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
	ssl_certificate_key 	/etc/letsencrypt/live/${DOMAIN}/privkey.pem;
	include             	/etc/nginx/options-ssl-nginx.conf;
	ssl_dhparam         	/etc/nginx/ssl-dhparams.pem;
	include				    /etc/nginx/includes/proxy_headers.conf;
	server_tokens      		off;

	proxy_set_header    	X-Forwarded-Port    $x_forwarded_port;

	# location for http        
	location / {          
		# Handle preflight requests
		if ($request_method = OPTIONS) {
			include		/etc/nginx/includes/preflight_request_headers.conf;
			return 204;
		}
		include			/etc/nginx/includes/cors_headers.conf;
		proxy_pass		http://socket_backend;
	}

	location /static {
		alias /vol/web/static/; 
	}

	# location for websockets
	location /ws/ {
		proxy_pass 			    http://socket_backend;
		proxy_http_version		1.1;
		proxy_set_header 	  	Upgrade $http_upgrade;
		proxy_set_header 	  	Connection "upgrade";
	}

	location /conf/ {
		alias					/home/ubuntu/code/vars/;
		auth_basic 				"Configuration";
		auth_basic_user_file 	/home/ubuntu/.htpasswd;
	}

	location /docs {
		auth_basic				"Documentation";
		auth_basic_user_file 	/home/ubuntu/.htpasswd;

		if ($request_method = OPTIONS) {
			include		/etc/nginx/includes/preflight_request_headers.conf;
			return 204;
		}

		include		/etc/nginx/includes/cors_headers.conf;
		include		/etc/nginx/includes/proxy_headers.conf;
		proxy_pass	http://socket_backend/docs;
	}
}

upstream backend_stage {
    server backend_stage:8001;
}

server {
	listen 				    443 ssl;
	server_name 		    stage.${DOMAIN};
	ssl_certificate     	/etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
	ssl_certificate_key 	/etc/letsencrypt/live/${DOMAIN}/privkey.pem;
	include             	/etc/nginx/options-ssl-nginx.conf;
	ssl_dhparam         	/etc/nginx/ssl-dhparams.pem;
	include					/etc/nginx/includes/proxy_headers.conf;
	server_tokens   	  	off;

	proxy_set_header    	X-Forwarded-Port    $x_forwarded_port;

	location / {
	    proxy_pass 		http://backend_stage; 
	}

	# location for websockets
	location /ws/ {
		proxy_pass 			http://backend_stage;
		proxy_http_version	1.1;
		proxy_set_header 	Upgrade $http_upgrade;
		proxy_set_header 	Connection "upgrade";
	}

	location /static {
		alias /vol/web/static/;
	}
}